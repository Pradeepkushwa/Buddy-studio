# Copy to .env and paste REAL values there (.env is gitignored — never commit it)
# cp .env.example .env

# ── LLM (default: free Google Gemini) ─────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest

# ── Optional: paid OpenAI (set LLM_PROVIDER=openai) ─────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# ── Optional: no LLM — only knowledge base + escalation ───────────────────────
# LLM_PROVIDER=none

# ── Support contact (shown on escalation) ─────────────────────────────────────
SUPPORT_PHONE=+91-XXXXXXXXXX
SUPPORT_WHATSAPP=+91-XXXXXXXXXX

# CORS — your frontend URL(s), comma-separated
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com

MAX_HISTORY_MESSAGES=20
ESCALATION_THRESHOLD=3
