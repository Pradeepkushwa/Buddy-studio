# ── DOCKER LOCAL DEV — copy this file ──────────────────────────────────────────
# cp .env.docker.example .env.docker
# Fill in GEMINI_API_KEY and SUPPORT_PHONE — rest can stay as-is for local dev.
# .env.docker is gitignored — never commit real secrets.
# ───────────────────────────────────────────────────────────────────────────────

# ── Python Agent (buddy-agent) ─────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional: OpenAI instead of Gemini
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# Optional: No LLM — KB + escalation only (good for local testing)
# LLM_PROVIDER=none

SUPPORT_PHONE=+91-XXXXXXXXXX
SUPPORT_WHATSAPP=+91-XXXXXXXXXX

MAX_HISTORY_MESSAGES=20
ESCALATION_THRESHOLD=3
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── React Frontend ─────────────────────────────────────────────────────────────
# These are overridden in docker-compose.yml to point to localhost
REACT_APP_API_URL=http://localhost:3001
REACT_APP_AGENT_URL=http://localhost:8000
REACT_APP_SUPPORT_PHONE=+91-XXXXXXXXXX

# ── Rails Backend ──────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=local_dev_secret_key_not_used_in_production
